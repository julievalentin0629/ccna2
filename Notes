vlan assignment -- how to assign vlan 10
!@A1
conf t
 interface e0/0
  switchport mode access
  switchport access vlan 10
end

show vlan br

!@A2\
conf t
 interface e1/0
  switchport mode access
  switchport access vlan 10
end

show vlan br


